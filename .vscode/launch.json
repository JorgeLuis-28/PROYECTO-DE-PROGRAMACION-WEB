{
    // F5 (o Run > Start Debugging) enciende el servidor y abre la página sola
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Iniciar servidor (localhost:8080)",
            "program": "${workspaceFolder}/server.js",
            "preLaunchTask": "Instalar dependencias",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        }
    ]
}
